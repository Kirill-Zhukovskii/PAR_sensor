# ADS1115 Linux IIO settings. "auto" discovers the ADS1115 device.
ADC_IIO_DEVICE=auto
ADC_CHANNEL=0
ADC_SAMPLES=5

# PAR-2.5V conversion: 0-2.5 V equals 0-2500 umol/m2/s.
PAR_SENSOR_MAX_VOLTAGE=2.5
PAR_SENSOR_MAX_VALUE=2500

# Local web server
WEB_HOST=0.0.0.0
WEB_PORT=8000

# Stable Bonjour/mDNS name used by the install script
DEVICE_HOSTNAME=par-sensor

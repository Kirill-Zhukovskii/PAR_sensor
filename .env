# USB-to-RS485 serial device on the Raspberry Pi
SERIAL_PORT=/dev/ttyUSB0

# S-PAR-02 Modbus settings
MODBUS_SLAVE_ADDRESS=1
MODBUS_BAUDRATE=9600
MODBUS_TIMEOUT_SECONDS=1.0

# Local web server
WEB_HOST=0.0.0.0
WEB_PORT=8000

# Stable Bonjour/mDNS name used by the install script
DEVICE_HOSTNAME=par-sensor
